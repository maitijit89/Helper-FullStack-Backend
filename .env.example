# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME="Helping Services"
VERSION="1.2.1"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ==========================================
# Security & Authentication (JWT & OTP)
# ==========================================
JWT_SECRET="your-256-bit-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
OTP_EXPIRES_IN_MINUTES=10
REGISTRATION_REMINDER_DAYS=3

# ==========================================
# Sub-Backend Integration (User Analysis Engine)
# ==========================================
ANALYSIS_ENGINE_SECRET="helping-services-analysis-engine-secret-2026"
CART_DWELL_BOOST_MINUTES=15

# ==========================================
# Email Configuration (SMTP / Nodemailer)
# ==========================================
# If omitted or blank, emails are logged to console in development
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Helping Services <noreply@helpingservices.com>"
SMTP_SECURE=false

# ==========================================
# Database Configuration (3 Interconnected MongoDB Databases)
# ==========================================
# MongoDB Cluster URI (Local or Atlas)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="helping_services_db"

# 1. Core / Identity DB (Users, Roles, Auth, Sessions)
MONGODB_CORE_DB_NAME="helping_services_core"

# 2. Product Catalog DB (Admin Uploads, Products, Categories, Accessories)
MONGODB_CATALOG_DB_NAME="helping_services_catalog"

# 3. User Intelligence & Analytics DB (Cart Sessions, Dwell Times, Interest Profiles, Events)
MONGODB_ANALYTICS_DB_NAME="helping_services_analytics"

MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# ==========================================
# Distributed Cache (Upstash Redis)
# ==========================================
REDIS_URL="rediss://default:your-upstash-password@your-upstash-db.upstash.io:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==========================================
# Object Storage (Cloudflare R2)
# ==========================================
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="app-uploads"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
CLOUDFLARE_R2_ENDPOINT=""
