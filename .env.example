# Application Configuration
PROJECT_NAME="FastAPI Production Base (MongoDB)"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security Configuration
SECRET_KEY="supersecretkey-change-this-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (JSON list string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000"]

# Database Configuration (MongoDB)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="fastapi_db"
