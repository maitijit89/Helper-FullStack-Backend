# Application Configuration
PROJECT_NAME="FastAPI Production Base (MongoDB)"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security Configuration
SECRET_KEY="supersecretkey-change-this-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (JSON list string or comma-separated string)
# For Vercel, include your deployed frontend domains (e.g., https://your-app.vercel.app)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-frontend.vercel.app"]

# Database Configuration (MongoDB)
# For Vercel production, use a cloud database string like MongoDB Atlas:
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="fastapi_db"

# Google SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER="your-gmail-account@gmail.com"
SMTP_PASSWORD="your-16-char-google-app-password"
EMAILS_FROM_EMAIL="your-gmail-account@gmail.com"
EMAILS_FROM_NAME="Helping Services Team"

# AWS S3 Storage Configuration
STORAGE_PROVIDER="s3"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_STORAGE_BUCKET_NAME="helper-app-uploads-prod-2026"
AWS_S3_REGION_NAME="ap-south-1"

# Upstash Redis Configuration
REDIS_URL="rediss://default:your-upstash-password@your-upstash-db.upstash.io:6379"

# Mappls (MapmyIndia) Configuration
MAPPLS_REST_API_KEY="your-mappls-rest-api-key"

# Google Gemini AI Configuration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"

# Google Sheets Integration Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_SHEET_NAME="Partner Applications"
GOOGLE_SERVICE_ACCOUNT_FILE=""
GOOGLE_SERVICE_ACCOUNT_INFO=""
GOOGLE_SHEET_WEBHOOK_URL=""

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Server Keep-Alive / Wake-Up Configuration (for Render free tier)
ENABLE_KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_SECONDS=120
SERVER_URL=""






