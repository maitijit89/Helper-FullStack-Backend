# Application Configuration
PROJECT_NAME="Helping Services"
VERSION="1.2.1"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security Configuration
SECRET_KEY="supersecretkey-change-this-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (JSON list string or comma-separated string)
# Include your frontend domains (e.g. localhost, Vercel, production domains)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-frontend.vercel.app"]

# Database Configuration (MongoDB)
# Local: mongodb://localhost:27017
# Production / Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="fastapi_db"
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Upstash Redis Configuration (Distributed Caching & Real-Time Sync)
# Format: rediss://default:<password>@<db-name>.upstash.io:6379
REDIS_URL="rediss://default:your-upstash-password@your-upstash-db.upstash.io:6379"
# Optional REST API credentials for Serverless / Edge
UPSTASH_REDIS_REST_URL="https://your-upstash-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Storage Configuration: Cloudflare R2 (Recommended, 0 egress fees) or AWS S3
STORAGE_PROVIDER="r2" # "r2" | "s3" | "local"
# Cloudflare R2 Credentials
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="helper-uploads"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-yourbucket.r2.dev" # or https://media.yourdomain.com
CLOUDFLARE_R2_ENDPOINT="" # Optional custom endpoint

# AWS S3 Fallback Credentials
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_STORAGE_BUCKET_NAME=""
AWS_S3_REGION_NAME="ap-south-1"

# Mappls (MapmyIndia) Configuration
MAPPLS_REST_API_KEY="your-mappls-rest-api-key"

# Google Gemini AI Configuration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"

# Google Sheets Integration Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_SHEET_NAME="Partner Applications"
GOOGLE_SERVICE_ACCOUNT_FILE=""
GOOGLE_SERVICE_ACCOUNT_INFO=""
GOOGLE_SHEET_WEBHOOK_URL=""

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Server Keep-Alive / Wake-Up Configuration (for Render free tier)
ENABLE_KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_SECONDS=120
SERVER_URL=""






