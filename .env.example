# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME="Backend Core API"
VERSION="1.2.1"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security & JWT Configuration
# Generate a secure key: openssl rand -hex 32
SECRET_KEY="supersecretkey-change-this-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ==========================================
# Database Configuration (MongoDB)
# ==========================================
# Local: mongodb://localhost:27017
# Production Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="app_db"
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# ==========================================
# Distributed Cache (Upstash Redis)
# ==========================================
# Upstash Redis TLS connection string
# Format: rediss://default:<password>@<db-name>.upstash.io:6379
REDIS_URL="rediss://default:your-upstash-password@your-upstash-db.upstash.io:6379"

# Optional: Upstash Redis REST API (Serverless / Edge)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==========================================
# Object Storage (Cloudflare R2)
# ==========================================
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="app-uploads"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev" # or https://media.yourdomain.com
CLOUDFLARE_R2_ENDPOINT="" # Optional custom endpoint override
